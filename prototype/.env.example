# =====================================================================
#  PODESAVANJA ZA LLM
#  1) Napravi kopiju ovog fajla i nazovi je  .env   (bez .example)
#  2) Upisi svoj API kljuc
#  .env se NE salje na GitHub (nalazi se u .gitignore) - kljuc ostaje tajna!
# =====================================================================

# false = mock rezim (hello world, bez interneta i kljuca)
# true  = pravi pozivi ka modelu
LLM_ENABLED=false

# ---- Google Gemini (besplatan nivo preko Google AI Studio) ----
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=ovde-nalepi-svoj-kljuc
LLM_MODEL=gemini-3.8-flash
LLM_REASONING_EFFORT=low     # manje "razmisljanja" = brzi odgovori i manja potrosnja

# ---- Groq (alternativa, takodje ima besplatan nivo) ----
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=ovde-nalepi-svoj-kljuc
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_REASONING_EFFORT=        # za Groq ostavi prazno

# ---- Ostala podesavanja ----
LLM_TEMPERATURE=0.7
LLM_MAX_PARALLEL=2      # koliko poziva istovremeno (besplatni nalozi imaju limit u minuti)
LLM_MAX_RETRIES=2       # koliko puta ponoviti poziv ako servis kaze "previse zahteva"
LLM_TIMEOUT=300         # koliko sekundi cekati odgovor modela
