# opis: Svaki nastavni ishod mora biti pokriven bar jednom nastavnom jedinicom.
# odgovoran: curriculum_structure
PREFIX :     <http://example.org/kurikulum#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?cvor ?poruka WHERE {
  ?cvor a :NastavniIshod .
  FILTER NOT EXISTS { ?j :pokrivaIshod ?cvor }
  OPTIONAL { ?cvor rdfs:label ?naziv }
  BIND(CONCAT("Ishod '", COALESCE(?naziv, STR(?cvor)), "' ne pokriva nijedna nastavna jedinica") AS ?poruka)
}
